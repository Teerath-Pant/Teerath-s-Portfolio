{
  "name": "portfolio-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "set-password": "node scripts/set-password.mjs",
    "smoke": "node scripts/smoke.mjs",
    "preview-email": "node scripts/preview-email.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "worker-mailer": "^1.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3",
    "wrangler": "^4.165.0"
  }
}
